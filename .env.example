# Auto-updates settings.silver_rate_per_gram from FENEGOSIDA's public today-rate API.
SILVER_RATE_SYNC_ENABLED=true
SILVER_RATE_SYNC_CRON=0 6,12,18 * * *
SILVER_RATE_SYNC_TZ=Asia/Kathmandu
