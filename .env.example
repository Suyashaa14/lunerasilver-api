PORT=4000
NODE_ENV=development
FE_BASE_URL=http://localhost:3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lunerasilver

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@lunerasilver.com
